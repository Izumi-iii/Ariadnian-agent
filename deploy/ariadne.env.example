# Ariadne 网页版部署配置。复制为 deploy/ariadne.env 后填写（该文件已被 .gitignore 忽略，不要提交）。

# ---- 安全（部署给别人用时务必设置）----
# 访问密码：打开网页时浏览器会弹出登录框，用户名随意（或设置 ARIA_USERNAME 限定）
ARIA_PASSWORD=
# ARIA_USERNAME=
# 锁定「设置」：其他人只能查看，不能改模型、改密钥，也不能拿你的 Key 去测试别的地址
ARIA_LOCK_SETTINGS=1
# 上传文件大小上限（MB）
ARIA_MAX_UPLOAD_MB=50

# ---- 模型 ----
# 设置被锁定时只能在这里配置；想先在网页「设置」里调好，可以暂时把 ARIA_LOCK_SETTINGS 设成 0，调好后改回 1 并重启
LLM_API_KEY=
# LLM_API_BASE=
MODEL_ID=deepseek/deepseek-chat
# FAST_MODEL_ID=deepseek/deepseek-chat

# ---- PDF 全文解析（可选）----
# 默认 pymupdf：零依赖，普通英文论文足够。复杂排版、公式、中文或扫描版 PDF 可以换成 GROBID / MinerU，
# 并用对应的 profile 启动服务；服务不可用时会自动退回 pymupdf，上传不会失败。
# PDF_PARSER=grobid
# GROBID_URL=http://grobid:8070
# PDF_PARSER=mineru
# MINERU_URL=http://mineru:8000
# MINERU_BACKEND=pipeline        # pipeline（显存 4GB+，最稳）/ hybrid-auto-engine / vlm-auto-engine（显存 8GB+，更准）

# ---- HTTPS（使用 --profile https 时需要）----
# DOMAIN=ariadne.example.com
