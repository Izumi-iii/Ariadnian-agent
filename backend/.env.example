# 复制为 backend/.env（或仓库根目录 .env）后填写。

# ======================= 模型（LiteLLM） =======================
# 模型名用 LiteLLM 格式：<provider>/<model>
#   DeepSeek       deepseek/deepseek-chat
#   通义 / Kimi / 智谱 / 硅基流动 / mimo 等 OpenAI 兼容服务   openai/<模型名>（同时填 LLM_API_BASE）
#   本地 Ollama    ollama_chat/qwen2.5:7b（LLM_API_BASE=http://localhost:11434）
#   Claude / Gemini 等原生接口也可以，见 https://docs.litellm.ai/docs/providers
LLM_API_KEY=
LLM_API_BASE=                     # DeepSeek 原生前缀可不填；OpenAI 兼容服务填它的 /v1 地址

# 主模型与快模型：四档模型没单独配置时，从这两个取默认值
MODEL_ID=deepseek/deepseek-chat
FAST_MODEL_ID=deepseek/deepseek-chat

# ---- 按任务分档（可选，不填则用上面的默认值）----
# complete  行内续写：延迟最敏感，建议用非推理的快模型；超时直接放弃，不打扰写作
# MODEL_COMPLETE=deepseek/deepseek-chat
# MODEL_COMPLETE_TIMEOUT=8
# write     选中改写、文献问答：质量优先
# MODEL_WRITE=deepseek/deepseek-chat
# judge     引用判断、中文→英文检索关键词：量大，用便宜稳定的模型
# MODEL_JUDGE=deepseek/deepseek-chat
# agent     综述与大纲：长上下文、稳定输出 JSON
# MODEL_AGENT=deepseek/deepseek-chat
# MODEL_AGENT_FALLBACKS=openai/qwen-plus     # 主模型失败时依次尝试的备用模型（逗号分隔）

# 每档也可以单独指定 key / 地址，例如补全走本地 Ollama：
# MODEL_COMPLETE=ollama_chat/qwen2.5:7b
# MODEL_COMPLETE_API_BASE=http://localhost:11434

# 不想花 token、只想看界面和流程：设为 1，所有模型调用和学术检索都会返回演示内容
LLM_FAKE=0

# ======================= 向量检索（可选，默认只用 BM25） =======================
# 中文写作 + 英文文献，强烈建议开启多语言嵌入模型，例如 Ollama 的 bge-m3
EMBEDDING_PROVIDER=none           # none | ollama | openai
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BASE_URL=http://localhost:11434

# ======================= 学术检索 =======================
# Semantic Scholar：不填 key 时与所有匿名用户共享配额，高峰期经常 429。
# 免费申请（邮件发放，独立的 1 次/秒额度）：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex：Semantic Scholar 被限流时自动补位。不填 key 每天约 100 次检索，免费 key 约 1000 次。
# 申请方式见 https://developers.openalex.org/api-reference/authentication
OPENALEX_API_KEY=

# 检索结果缓存天数（同一检索式不重复请求），0 表示不缓存
SEARCH_CACHE_DAYS=7

# 数据目录（SQLite 数据库、PDF、LangGraph checkpoint），默认 backend/data
# ARIA_DATA_DIR=
